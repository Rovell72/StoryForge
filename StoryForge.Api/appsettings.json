{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=StoryForge;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Story": {
    "PromotionThreshold": 5,
    "RejectionThreshold": 5,
    "MergeVoteThreshold": 5,
    "MinReputationToMerge": 20,
    "ReputationPerPromotion": 10,
    "ReputationPerMerge": 5,
    "RoundCheckIntervalSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
